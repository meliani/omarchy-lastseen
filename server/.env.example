# Copied to .env by install.sh, which fills the secrets with random values.

# Public address of the API, as the desktop will reach it.
# With the https profile: https://<EVOLUTION_DOMAIN>
SERVER_URL=http://localhost:8080

# Only for `docker compose --profile https`: a DNS name pointing at this server.
EVOLUTION_DOMAIN=

# Where the API listens. 127.0.0.1 = this machine only (use with https or a tunnel);
# 0.0.0.0 = every network (only on a private network).
EVOLUTION_BIND=127.0.0.1
EVOLUTION_PORT=8080

# RabbitMQ for instant updates on the desktop. Private networks only.
AMQP_BIND=127.0.0.1
AMQP_PORT=5672

# Secrets (install.sh generates them)
EVOLUTION_API_KEY=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
DESKTOP_AMQP_PASSWORD=
